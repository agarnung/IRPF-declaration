# IRPF-declaration — configuración local (NO commitear; .env está en .gitignore)
# Plantilla: copia este archivo a .env y rellena solo los valores.
#
# Si no defines nada, process_paypal.py funciona en modo mock + heurístico,
# sin credenciales de ningún tipo.

# --- PayPal ---
# PAYPAL_MODE=mock: datos de ejemplo, sin red ni credenciales (por defecto)
# PAYPAL_MODE=real: usa el sandbox real de PayPal (requiere Client ID/Secret)
PAYPAL_MODE=mock
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PAYPAL_ENV=sandbox (por defecto) | live
PAYPAL_ENV=sandbox
# Si Transaction Search devuelve 403 NOT_AUTHORIZED: activa "Transaction Search"
# en Apps & Credentials -> Sandbox -> (tu app) -> Sandbox App Settings, o crea
# una app nueva tipo Merchant con ese feature y actualiza aquí Client ID/Secret.

# Cuentas sandbox (solo para entrar en sandbox.paypal.com; el pipeline NO las usa)
PAYPAL_ACCOUNT_EMAIL=
PAYPAL_ACCOUNT_PASSWORD=
PAYPAL_SANDBOX_BUSINESS_EMAIL=
PAYPAL_SANDBOX_BUSINESS_PASSWORD=

# --- Clasificador (LLM) ---
# CLASSIFIER_MODE=heuristic: reglas simples, sin API key (por defecto)
# CLASSIFIER_MODE=llm: usa un LLM real (requiere OPENAI_API_KEY o LITELLM_*)
CLASSIFIER_MODE=heuristic
OPENAI_API_KEY=
# OPENAI_BASE_URL: opcional; Azure OpenAI, OpenRouter, Groq, vLLM propio...
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
# Ejemplo LLM local con LiteLLM (proxy OpenAI-compatible):
# CLASSIFIER_MODE=llm
# OPENAI_API_KEY=sk-local
# OPENAI_BASE_URL=http://127.0.0.1:4000/v1
# OPENAI_MODEL=ollama/llama3.1
# O al estilo LiteLLM (como en tus otros proyectos):
# CLASSIFIER_MODE=llm
# LITELLM_API_KEY=sk-local
# LITELLM_BASE_URL=http://127.0.0.1:4000
# LLM_MODEL=ollama/llama3.1
