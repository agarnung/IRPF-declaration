# Copia este archivo a .env (o exporta las variables tal cual) para activar
# los modos "reales" del módulo de PayPal. NUNCA subas un .env con valores
# reales al repositorio (ya está en .gitignore).
#
# Si no defines nada, process_paypal.py funciona igualmente en modo mock +
# clasificador heurístico, sin credenciales de ningún tipo.

# --- PayPal ---
# PAYPAL_MODE=mock          # (por defecto) datos de ejemplo, sin red ni credenciales
# PAYPAL_MODE=real          # usa el sandbox real de PayPal (requiere las 2 vars siguientes)
PAYPAL_MODE=mock
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox          # sandbox (por defecto) | live

# --- Clasificador (LLM) ---
# CLASSIFIER_MODE=heuristic # (por defecto) reglas simples, sin API key
# CLASSIFIER_MODE=llm       # usa un LLM real (requiere OPENAI_API_KEY)
CLASSIFIER_MODE=heuristic
OPENAI_API_KEY=
OPENAI_BASE_URL=            # opcional: Azure OpenAI, OpenRouter, Groq, vLLM propio...
# Ejemplo LLM local con LiteLLM (proxy OpenAI-compatible):
# CLASSIFIER_MODE=llm
# OPENAI_API_KEY=sk-local
# OPENAI_BASE_URL=http://127.0.0.1:4000/v1
# OPENAI_MODEL=ollama/llama3.1
# O al estilo LiteLLM (como en tus otros proyectos):
# CLASSIFIER_MODE=llm
# LITELLM_API_KEY=sk-local
# LITELLM_BASE_URL=http://127.0.0.1:4000
# LLM_MODEL=ollama/llama3.1
OPENAI_MODEL=gpt-4o-mini
